{\rtf1\ansi\ansicpg1251\uc1\deff0\stshfdbch0\stshfloch0\stshfhich0\stshfbi0\deftab720{\fonttbl{\f0\froman\fcharset204 Times New Roman;}{\f1\fdontcare\fcharset204 Symbol;}{\f2\fnil\fcharset204{\*\fname Arial;}Arial;}{\f3\fswiss\fcharset204 Tahoma;}{\f4\fmodern\fcharset204{\*\panose 02070309020205020404}Courier New;}{\f5\fswiss\fcharset204\fprq2 Arial Narrow;}{\f6\fnil\fcharset204{\*\fname Verdana;}Verdana CYR;}{\f7\fbidi \fswiss\fcharset204\fprq2{\*\panose 020f0502020204030204}Calibri;}{\f8\fbidi \fswiss\fcharset204\fprq2{\*\panose 020b0a04020102020204}Arial Black;}{\f9\fbidi \froman\fcharset2\fprq2{\*\panose 05030102010509060703}Webdings;}{\f10\fbidi \fnil\fcharset2\fprq2{\*\panose 05000000000000000000}Wingdings;}}{\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;\red255\green0\blue255;\red255\green0\blue0;\red255\green255\blue0;\red255\green255\blue255;\red0\green0\blue128;\red0\green128\blue128;\red0\green128\blue0;\red128\green0\blue128;\red128\green0\blue0;\red128\green128\blue0;\red128\green128\blue128;\red192\green192\blue192;\red192\green192\blue192;\red51\green153\blue102;}{\stylesheet{\s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0 \b\f0\fs32\kerning32\cgrid \sbasedon0 \snext0 \styrsid1533179 heading 1;}{\s2\ql \li0\ri0\sb240\sa60\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel1\adjustright\rin0\lin0\itap0 \b\i\f0\fs28\cgrid \sbasedon0 \snext0 \styrsid5314647 heading 2;}{\s3\ql \li0\ri0\sb240\sa60\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel2\adjustright\rin0\lin0\itap0 \b\f0\fs26\cgrid \sbasedon0 \snext0 \styrsid5314648 heading 3;}}\paperw11906\paperh16838\margl1134\margr1134\margt850\margb850 {\header\pard\plain\qc \li0\ri0\widctlpar\faauto\adjustright\rin0\lin0\itap0 {{\plain\f0 \fs20 {{{\trowd \irow1\irowband1\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalc\clvmgf\clcbpat8\cellx5669\clvertalc\clvmgf\clcbpat8\cellx9354\ql\intbl{Тендер № 0076-PROC-2026}\cell\qr\intbl{ПРИЛОЖЕНИЕ №1}\cell\row\b0}}\intbl\pard}\plain }\par}}{\footer\pard\plain\qc \li0\ri0\widctlpar\faauto\adjustright\rin0\lin0\itap0 {{\plain\f0 \fs20 {{{\trowd \irow1\irowband1\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalc\clvmgf\clcbpat8\cellx5669\clvertalc\clvmgf\clcbpat8\cellx9354\ql\intbl{}\cell\qr\intbl{Страница {\field{\*\fldinst { PAGE }}} из {\field{\*\fldinst { NUMPAGES }}}}\cell\row\b0}}\intbl\pard}\plain }\par}}{\s1\qc \li0\ri0\sb240\sa60\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid1533179 \b\f0{\fs28\kerning32\cgrid {\insrsid1533179 ИНСТРУКЦИЯ ДЛЯ УЧАСТНИКОВ МАЛЫХ ЗАКУПОК НА ЭТП \par}}\pard}\par {\s1\ql \li0\ri0\sb240\sa60\keepn\widctlpar\aspalpha\aspnum\faauto\outlinelevel0\adjustright\rin0\lin0\itap0\pararsid1533179 \b\f0{\fs28\kerning32\cgrid {\insrsid1533179 СОДЕРЖАНИЕ \par}}\pard}\par {\plain\f0 \fs28 {{{\trowd \irow1\irowband1\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-850 \clvertalc\clvmgf\cellx2268\clvertalc\clvmgf\cellx9355\ql\intbl{}\cell\ql\intbl{ОПРЕДЕЛЕНИЯ}\cell\row\b0}{\trowd \irow2\irowband2\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-283 \clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{}\cell\row\b0}{\trowd \irow3\irowband3\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {1.}\pard\b0}}\cell\ql\intbl{ВИД ЗАКУПОЧНОЙ ПРОЦЕДУРЫ МАЛОЙ ЗАКУПКИ }\cell\row\b0}{\trowd \irow4\irowband4\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {1.1.}\b0}}\cell\ql\intbl{Открытый одноэтапный тендер (запрос цен,   запрос   котировок)}\cell\row\b0}{\trowd \irow5\irowband5\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {2.}\b0}}\cell\ql\intbl{ПОДАЧА ТЕНДЕРНЫХ ПРЕДЛОЖЕНИЙ}\cell\row\b0}{\trowd \irow6\irowband6\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {2.1.}\b0}}\cell\ql\intbl{Общие правила}\cell\row\b0}{\trowd \irow7\irowband7\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {2.2.}\b0}}\cell\ql\intbl{Состав предложения}\cell\row\b0}{\trowd \irow8\irowband8\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {2.3.}\b0}}\cell\ql\intbl{Подписание документов}\cell\row\b0}{\trowd \irow9\irowband9\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {3.}\b0}}\cell\ql\intbl{ПОДГОТОВИТЕЛЬНЫЕ РАСХОДЫ}\cell\row\b0}{\trowd \irow10\irowband10\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {4.}\b0}}\cell\ql\intbl{НМЦ И ЦЕНООБРАЗОВАНИЕ}\cell\row\b0}{\trowd \irow11\irowband11\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {5.}\b0}}\cell\ql\intbl{ПЕРЕТОРЖКА}\cell\row\b0}{\trowd \irow12\irowband12\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {6.}\b0}}\cell\ql\intbl{ПРАВО ВЫБОРА}\cell\row\b0}{\trowd \irow13\irowband13\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {7.}\b0}}\cell\ql\intbl{ИЗМЕНЕНИЕ И ОТЗЫВ ПРЕДЛОЖЕНИЯ}\cell\row\b0}{\trowd \irow14\irowband14\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {8.}\b0}}\cell\ql\intbl{РАСЦЕНКИ}\cell\row\b0}{\trowd \irow15\irowband15\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {9.}\b0}}\cell\ql\intbl{ОТКЛОНЕНИЯ}\cell\row\b0}{\trowd \irow16\irowband16\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {10.}\b0}}\cell\ql\intbl{ЗАПРОС НА УТОЧНЕНИЕ}\cell\row\b0}{\trowd \irow17\irowband17\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {11.}\b0}}\cell\ql\intbl{ПОБЕДИТЕЛЬ ТЕНДЕРА}\cell\row\b0}{\trowd \irow18\irowband18\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {11.1.}\b0}}\cell\ql\intbl{Условие о подписании Договора}\cell\row\b0}{\trowd \irow19\irowband19\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {11.2.}\b0}}\cell\ql\intbl{Ответственность за уклонение}\cell\row\b0}{\trowd \irow20\irowband20\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {Приложение №1.1}\b0}}\cell\ql\intbl{Ответственность за уклонение}\cell\row\b0}{\trowd \irow21\irowband21\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{}\cell\row\b0}{\trowd \irow22\irowband22\ltrrow\trgaph28\trrh260\trleft0\trkeep\clvertalc\clvmgf\clcbpat8\cellx2268\clvertalc\clvmgf\clcbpat8\cellx9355\ql\intbl{{\b {Приложение 1.1}\b0}}\cell\ql\intbl{Образец письменного согласия Участника Тендера }\cell\row\b0}}\intbl\pard}\plain }\sbkpage\pgncont\ltrsect\sect {\plain\f0 \fs28 {\pard \qj \tab Настоящая Инструкция устанавливает порядок представления документов в электронной форме через электронную торговую площадку (далее - ЭТП) для участия в малых закупках АО «Каспийский Трубопроводный Консорциум-Р» / АО «Каспийский Трубопроводный Консорциум-К».\par}\pard {\pard \qj \tab Особенности малых закупок:\par}\pard {\pard \qj \tab - НМЦ может быть указана или не указана;\par}\pard {\pard \qj \tab - Переторжка проводиться по решению Компании.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql ОПРЕДЕЛЕНИЯ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab \b«Договор»\b0  - согласие двух или нескольких лиц об установлении, изменении или прекращении гражданских прав и обязанностей\par}\pard {\pard \qj \tab \b«Закупка/тендер»\b0   - последовательность действий, осуществляемых в соответствии с извещением, тендерной документацией, в результате которых заказчик проводит выбор поставщика (исполнителя, подрядчика) с последующим заключением договора и исполнением обязательств сторонами договора с целью своевременного и полного удовлетворения потребностей заказчика в товарах, работах, услугах;\par}\pard {\pard \qj \tab \b«Запрос на Уточнение»\b0  - документ, который Участник Тендера должен заполнить и направить контактному лицу Компании с целью получения уточнений.\par}\pard {\pard \qj \tab \b«Компания/Заказчик»\b0  - АО «Каспийский Трубопроводный Консорциум-Р» / АО «Каспийский Трубопроводный Консорциум-К».\par}\pard {\pard \qj \tab \b«Коммерческая часть»\b0   - комплект документов, содержащий предложение участника Тендера о выполнении работ, оказании услуг или поставки товаров и иные сведения, предусмотренные Тендерной документацией, направленной Компании по форме и в порядке, установленном Тендерной документацией.\par}\pard {\pard \qj \tab \b«Начальная (максимальная) цена договора (НМЦ)»\b0   - это предельная граница цены на закупаемый товар, работу или услугу, которая может быть указана в извещении о закупке, которую заказчик готов потратить.\par}\pard {\pard \qj \tab \b«Победитель Тендера»\b0  - Участник Тендера, предложение которого принято Компанией, что подтверждается в письменном виде.\par}\pard {\pard \qj \tab \b«Техническая часть заявки»\b0   - комплект документов, состоящий из технической части тендерного предложения, включающей документы, содержащие технические характеристики предлагаемого оборудования / материалов: техническое описание, руководство по эксплуатации, выдержки из каталогов, заполненные опросные листы (при наличии в Тендерной документации), габаритные и установочные чертежи (если применимо) и учетной карточки с реквизитами участника Тендера.\par}\pard {\pard \qj \tab \b«Тендерная документация»\b0  - комплект документов, размещенный на ЭТП в разделе соответствующего Тендера.\par}\pard {\pard \qj \tab \b«Тендерное Предложение/предложение»\b0  - комплект документов, состоящий из двух частей: технической части и коммерческой части заявки.\par}\pard {\pard \qj \tab \b«Усиленная квалифицированная электронная подпись (УКЭП)»\b0   - электронный аналог собственноручной подписи, обладающий юридической силой, подтверждённой государством.\par}\pard {\pard \qj \tab \b«Участник Тендера/тендера»\b0   - юридическое лицо, независимо от организационно-правовой формы, формы собственности, места нахождения и места происхождения капитала, физическое лицо, в том числе индивидуальный предприниматель.\par}\pard {\pard \qj \tab \b«Электронная торговая площадка (ЭТП)»\b0   - информационная система, обеспечивающая проведение тендерных процедур, подачу предложений, обмен документами и подписание договоров в электронном виде.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 1.  ВИД ЗАКУПОЧНОЙ ПРОЦЕДУРЫ МАЛОЙ ЗАКУПКИ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Вид закупочной процедуры малой закупки указывается в извещении, размещенном на ЭТП.\par}\pard \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 1.1.  Открытый одноэтапный тендер (запрос цен, запрос котировок)\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Участник подает тендерное предложение, включающее:\par}\pard {\pard \qj \tab -  Техническую часть;\par}\pard {\pard \qj \tab -  Коммерческую часть.\par}\pard {\pard \qj Оценка проводится после окончания срока подачи предложений.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 2.  ПОДАЧА ТЕНДЕРНЫХ ПРЕДЛОЖЕНИЙ\par}\pard \par {\pard \ql  \tab 2.1.  Общие правила:\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab - Предложения подаются исключительно через функционал ЭТП;\par}\pard {\pard \qj \tab - Дата и время подачи фиксируется автоматически;\par}\pard {\pard \qj \tab - Предложение, поданное после срока, не принимается системой.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 2.2.  Состав предложения:\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Состав документов определяется извещением о закупке и может включать:\par}\pard {\pard \qj \tab - Техническое описание;\par}\pard {\pard \qj \tab - Коммерческое предложение;\par}\pard {\pard \qj \tab - Сведения об участнике;\par}\pard {\pard \qj \tab - Согласие с условиями договора.\par}\pard \par \plain }{\plain\f0 \fs28 \ul {\pard \ql Требования к технической части предложения:\par}\pard \par \ulnone\plain }{\plain\f0 \fs28 {\pard \qj \tab Техническая часть предложения должна содержать документы, полной мере позволяющие определить технические характеристики предлагаемого оборудования / материалов / услуг:\par}\pard {\pard \qj \tab - техническое описание, руководство по эксплуатации, выдержки из каталогов;\par}\pard {\pard \qj \tab - заполненные опросные листы (при наличии в Тендерной документации);\par}\pard {\pard \qj \tab - габаритные и установочные чертежи (если применимо).\par}\pard \par \plain }{\plain\f0 \fs28 \ul {\pard \ql Требования к коммерческой части предложения:\par}\pard \par \ulnone\plain }{\plain\f0 \fs28 {\pard \qj \tab - Указываются сроки поставки (в календарных днях);\par}\pard {\pard \qj \tab - Условия оплаты: предоплата 30%, окончательная оплата 70% в течении 30 рабочих дней с даты поставки;\par}\pard {\pard \qj \tab - Цены формируются с учетом поставки товаров до складов Компании, на условиях, указанных в документации о закупке.\par}\pard {\pard \qj \tab - Валюта – рубли РФ (с обоснованием при использовании иной валюты);\par}\pard {\pard \qj \tab - Цены фиксируются минимум на 90 календарных дней.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 2.1.  Подписание документов:\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Документы подписываются:\par}\pard {\pard \qj \tab - Усиленной квалифицированной электронной подписью (УКЭП)\par}\pard {\pard \qj \tab или\par}\pard {\pard \qj \tab - Загружаются в виде подписанных скан-копий – если это прямо указано в извещении.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 3.  ПОДГОТОВИТЕЛЬНЫЕ РАСХОДЫ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Компания не несет ответственности в отношении любых расходов или издержек, связанных с составлением, подготовкой и/или представлением Предложения Участника Тендера через ЭТП.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 4.  НМЦ И ЦЕНООБРАЗОВАНИЕ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Устанавливается Компанией при необходимости и указывается в извещении только при применении. Превышение НМЦ не допускается\par}\pard {\pard \qj \tab Если НМЦ не указана, участники формируют цену самостоятельно.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 5.  ПЕРЕТОРЖКА\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Переторжка проводиться по решению Компании и при наличии конкуренции.\par}\pard {\pard \qj \tab Особенности:\par}\pard {\pard \qj \tab - Проводится на ЭТП;\par}\pard {\pard \qj \tab - Участники снижают цену поэтапно;\par}\pard {\pard \qj \tab - Участие добровольное.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 6.  ПРАВО ВЫБОРА\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Компания вправе:\par}\pard {\pard \qj \tab - Выбрать предложение, не имеющее минимальной цены, если оно является наиболее выгодным по совокупности критериев (включая: сроки поставки; улучшенные технические и функциональные характеристики; соответствие техническому заданию; гарантийные обязательства);\par}\pard {\pard \qj \tab - Отклонить предложения при несоответствии технических характеристик, превышения НМЦ, в случае указания таковой в извещении;\par}\pard {\pard \qj \tab - Принять решение о проведении повторного тендера с уведомлением участников через ЭТП.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 7.  ИЗМЕНЕНИЕ И ОТЗЫВ ПРЕДЛОЖЕНИЯ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Участник Тендера может изменить или отозвать свое предложение <b>через функционал ЭТП<\b>, до истечения срока подачи заявок.\par}\pard {\pard \qj \tab Компания вправе изменять положения тендерной документации до окончания приема предложений, уведомив всех участников через ЭТП.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 8.  РАСЦЕНКИ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Цены должны включать все издержки, налоги, сборы, пошлины, транспортные расходы и прибыль.\par}\pard {\pard \qj \tab Компания может запросить детализированную разбивку цены после выбора победителя.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 9.  ОТКЛОНЕНИЯ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Альтернативные предложения могут быть поданы как отдельные файлы через ЭТП, при условии четкого обозначения отклонений.\par}\pard {\pard \qj \tab Компания рассматривает такие предложения по своему усмотрению.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 10. ЗАПРОС НА УТОЧНЕНИЕ\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Участник может направить <b>Запрос на уточнение<\b> через ЭТП, заполнив форму Приложения № 3, не позднее чем за 3 рабочих дня до окончания приема предложений.\par}\pard {\pard \qj \tab Ответы публикуются на ЭТП и становятся доступны всем участникам.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 11. ПОБЕДИТЕЛЬ ТЕНДЕРА\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Компания официальным уведомлением через ЭТП информирует Победителя Тендера и остальных Участников о результатах процедуры.\par}\pard {\pard \qj \tab После получения уведомления о признании Победителем Тендера, Участник обязан заключить Договор <b>в сроки и в порядке, установленные Компанией.<\b>\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 11.1. Условие о подписании Договора\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab Подписание Договора осуществляется <b>в бумажном формате<\b>, посредством обмена оригинальными экземплярами, <b>не через функционал ЭТП<\b>, если иное прямо не указано в Тендерной документации или в уведомлении Компании.\par}\pard {\pard \qj \tab Победитель обязан:\par}\pard {\pard \qj \tab - Обеспечить предоставление в Компанию оригиналов подписанного Договора в количестве, указанном в уведомлении или проекте Договора;\par}\pard {\pard \qj \tab - Использовать подпись уполномоченного лица, полномочия которого подтверждены документально;\par}\pard {\pard \qj \tab - Направить оригиналы Договора в адрес Компании в установленные сроки и по указанным почтовым реквизитам.\par}\pard {\pard \qj \tab Электронные копии подписанного Договора, загруженные в ЭТП, принимаются <b>только как предварительное подтверждение<\b>, но не заменяют оригиналы.\par}\pard \par \plain }{\plain\f0 \fs28 \b {\pard \ql  \tab 11.2. Ответственность за уклонение\par}\pard \par \b0\plain }{\plain\f0 \fs28 {\pard \qj \tab В случае:\par}\pard {\pard \qj \tab - Уклонения Победителя от подписания Договора в бумажном формате,\par}\pard {\pard \qj \tab - Отказа от ранее предложенных условий,\par}\pard {\pard \qj \tab - Либо выдвижении новых условий, не предусмотренных тендерным предложением,\par}\pard {\pard \qj \tab Победитель включается в <b>список недобросовестных поставщиков Компании.<\b>\par}\pard \par \plain }{\plain\f0 \fs28 \ul {\pard \ql Компания вправе:\par}\pard \par \ulnone\plain }{\plain\f0 \fs28 {\pard \qj \tab - Определить нового Победителя из числа других участников;\par}\pard {\pard \qj \tab - Либо принять решение о проведении нового тендера.\par}\pard \par \plain }\sbkpage\pgncont\ltrsect\sect {\plain\f0 \fs24 \b {\pard \ql Приложение №1.1 к Инструкции Участникам Тендера\par}\pard {\pard \ql \tab \par}\pard {\pard \ql ОБРАЗЕЦ ПИСЬМЕННОГО СОГЛАСИЯ УЧАСТНИКА ТЕНДЕРА\par}\pard \par \b0\plain }{\plain\f0 \fs24 {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \tab  На бланке организации\par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \tab  Участник Тендера ________________________________________\par}\pard \par \par {\pard \qj \tab  Участник Тендера ознакомился и изучил документацию по Тендеру № 0076-PROC-2026, включая предлагаемую форму договора Компании, и подготовил свое предложение на участие в Тендере в соответствии с условиями, указанными в инструкции, без каких-либо оговорок.\par}\pard {\pard \qj \tab  Участник Тендера ознакомился и изучил содержание Кодекса делового поведения АО «КТК-Р»/ АО «КТК-К» и обязуется следовать его принципам и положениям в случае выбора победителем.\par}\pard {\pard \qj \tab  Участник Тендера понимает, что не имеет права вносить изменения в перечень номенклатуры к Тендеру и обязуется в случае выбора победителем принять к подписанию предлагаемую форму договора.\par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard {\pard \qj \par}\pard \plain }{\plain\f0 \fs20 {{{\trowd \irow1\irowband1\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalb\clvmgf\clcbpat8\cellx4535\clvertalb\clvmgf\clcbpat8\cellx9070\qc\intbl{_________________}\cell\qc\intbl{_________________}\cell\row\b0}{\trowd \irow2\irowband2\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalt\clvmgf\clcbpat8\cellx4535\clvertalt\clvmgf\clcbpat8\cellx9070\qc\intbl{   (дата)}\cell\qc\intbl{(подпись, печать)}\cell\row\b0}{\trowd \irow3\irowband3\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalc\clvmgf\clcbpat8\cellx4535\clvertalb\clvmgf\clcbpat8\cellx9070\qc\intbl{}\cell\qc\intbl{_________________}\cell\row\b0}{\trowd \irow4\irowband4\ltrrow\trgaph28\trrh260\trleft0\trkeep\trrh-567 \clvertalc\clvmgf\clcbpat8\cellx4535\clvertalt\clvmgf\clcbpat8\cellx9070\qc\intbl{}\cell\qc\intbl{(Ф.И.О., должность)}\cell\row\b0}}\intbl\pard}\plain }}}}