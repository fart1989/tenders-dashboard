icrosoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid wp14"><w:footnote w:type="separator" w:id="-1"><w:p w14:paraId="3EEBEBF3" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRDefault="00062F6C"><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:separator/></w:r></w:p></w:footnote><w:footnote w:type="continuationSeparator" w:id="0"><w:p w14:paraId="364D961D" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRDefault="00062F6C"><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:continuationSeparator/></w:r></w:p></w:footnote><w:footnote w:type="continuationNotice" w:id="1"><w:p w14:paraId="4F7E066E" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRDefault="00062F6C"><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/></w:pPr></w:p></w:footnote><w:footnote w:id="2"><w:p w14:paraId="01CF3434" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00FE2945" w:rsidRDefault="00062F6C" w:rsidP="00D533F7"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/></w:rPr></w:pPr><w:r w:rsidRPr="00FE2945"><w:rPr><w:rStyle w:val="afa"/><w:sz w:val="16"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00FE2945"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:sz w:val="16"/></w:rPr><w:t xml:space="preserve"> A4 — формат бумаги, определённый стандартом ISO 216, основан на метрической системе мер. Его размеры — 210×297 мм, диагональ — 364 мм. Площадь листа формата A4 = 1/16 м².</w:t></w:r></w:p></w:footnote><w:footnote w:id="3"><w:p w14:paraId="3AC72417" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:rStyle w:val="afa"/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> Если Поставщик не является плательщиком налога на добавленную стоимость, то при указании Цены Договора вместо указания суммы налога на добавленную стоимость ставится «без учета НДС» с обязательным указанием основания.</w:t></w:r></w:p></w:footnote><w:footnote w:id="4"><w:p w14:paraId="04C0484C" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:rStyle w:val="afa"/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:bookmarkStart w:id="25" w:name="_Hlk170381602"/><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>В случае применения антидемпинговых мер в соответствии с пунктом 2.24 Положения о закупке, в договоре, заключаемом с участником по итогам закупки, величина неустойки (штрафов, пеней), определяемая в соответствии с п. 2.14.6 – 2.14.9 Положения о закупке, на основании пункта 2.14.9.1 Положения о закупке, устанавливается в двукратном размере).</w:t></w:r><w:bookmarkEnd w:id="25"/></w:p><w:p w14:paraId="5FA23917" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr></w:p></w:footnote><w:footnote w:id="5"><w:p w14:paraId="6D750B02" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:rStyle w:val="afa"/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> Размер штрафа устанавливается в следующем порядке:</w:t></w:r></w:p><w:p w14:paraId="3E343BE5" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="0039789A" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="0039789A"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>а) 10 процентов цены договора (этапа, отчетного периода) в случае, если цена договора (этапа) не превышает 5 000 000 рублей (включительно);</w:t></w:r></w:p><w:p w14:paraId="74EA96E1" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="0039789A" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="0039789A"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>б) 5 процентов цены договора (этапа, отчетного периода) в случае, если цена договора (этапа) составляет от 5 000 000,01 рубля до 50 000 000 рублей (включительно);</w:t></w:r></w:p><w:p w14:paraId="66AB3C02" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="0039789A" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="0039789A"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>в) 1 процент цены договора (этапа, отчетного периода) в случае, если цена договора (этапа) составляет от 50 000 000,01 рубля до 100 000 000 рублей (включительно);</w:t></w:r></w:p><w:p w14:paraId="522A05BF" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="0039789A"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>г) 0,5 процента цены договора (этапа, отчетного периода) в случае, если цена договора (этапа) составляет от 100 000 000,01 рубля до 500 000 000 рублей (включительно).</w:t></w:r></w:p><w:p w14:paraId="312B553E" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6671F1BB" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>В случае применения антидемпинговых мер в соответствии с пунктом 2.24 Положения о закупке, в договоре, заключаемом с участником по итогам закупки, величина неустойки (штрафов, пеней), определяемая в соответствии с п. 2.14.6 – 2.14.9 Положения о закупке, на основании пункта 2.14.9.1 Положения о закупке, устанавливается в двукратном размере).</w:t></w:r></w:p><w:p w14:paraId="3C537457" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr></w:p></w:footnote><w:footnote w:id="6"><w:p w14:paraId="68A30C8A" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:rStyle w:val="afa"/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> Указывается при заключении Договора.</w:t></w:r></w:p></w:footnote><w:footnote w:id="7"><w:p w14:paraId="5224E94A" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:rStyle w:val="afa"/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> Размер штрафа устанавливается в следующем порядке:</w:t></w:r></w:p><w:p w14:paraId="6D16AFF2" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>а) 10 000 рублей, если цена договора не превышает 3 000 000 рублей (включительно);</w:t></w:r></w:p><w:p w14:paraId="1A68BE9E" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>б) 50 000 рублей, если цена договора составляет от 3 000 000,01 рубля до 50 000 000 рублей (включительно);</w:t></w:r></w:p><w:p w14:paraId="3F6575DC" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>в) 100 000 рублей, если цена договора составляет от 50 000 000,01 рубля до 100 000 000 рублей (включительно);</w:t></w:r></w:p><w:p w14:paraId="3267572F" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>г) 500 000 рублей, если цена договора превышает 100 000 000,01 рубль</w:t></w:r></w:p><w:p w14:paraId="41886CE2" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BB17F4" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr></w:p><w:p w14:paraId="29C5E688" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00BF5FB5" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="00BB17F4"><w:rPr><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>В случае применения антидемпинговых мер в соответствии с пунктом 2.24 Положения о закупке, в договоре, заключаемом с участником по итогам закупки, величина неустойки (штрафов, пеней), определяемая в соответствии с п. 2.14.6 – 2.14.9 Положения о закупке, на основании пункта 2.14.9.1 Положения о закупке, устанавливается в двукратном размере).</w:t></w:r></w:p></w:footnote><w:footnote w:id="8"><w:p w14:paraId="2829AD60" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="00451D26" w:rsidRDefault="00062F6C" w:rsidP="00D86CD8"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:i/><w:sz w:val="16"/><w:szCs w:val="16"/></w:rPr></w:pPr><w:r w:rsidRPr="00451D26"><w:rPr><w:rStyle w:val="afa"/><w:i/><w:sz w:val="16"/><w:szCs w:val="16"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="00451D26"><w:rPr><w:i/><w:sz w:val="16"/><w:szCs w:val="16"/></w:rPr><w:t xml:space="preserve"> Указать, если применимо.</w:t></w:r></w:p></w:footnote><w:footnote w:id="9"><w:p w14:paraId="243A9D01" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="0076634D" w:rsidRDefault="00062F6C" w:rsidP="002C5EED"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="0076634D"><w:rPr><w:rStyle w:val="afa"/><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="0076634D"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> Если применимо, указать процент НДС.</w:t></w:r></w:p></w:footnote><w:footnote w:id="10"><w:p w14:paraId="704677C3" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="0076634D" w:rsidRDefault="00062F6C" w:rsidP="002C5EED"><w:pPr><w:pStyle w:val="af8"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr></w:pPr><w:r w:rsidRPr="0076634D"><w:rPr><w:rStyle w:val="afa"/><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="0076634D"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> Если применимо, указать процент НДС.</w:t></w:r></w:p></w:footnote><w:footnote w:id="11"><w:p w14:paraId="5A6D5B9D" w14:textId="77777777" w:rsidR="00062F6C" w:rsidRPr="001519D0" w:rsidRDefault="00062F6C" w:rsidP="002C5EED"><w:pPr><w:pStyle w:val="af8"/><w:jc w:val="both"/><w:rPr><w:i/><w:sz w:val="16"/><w:szCs w:val="16"/></w:rPr></w:pPr><w:r w:rsidRPr="0076634D"><w:rPr><w:rStyle w:val="afa"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:footnoteRef/></w:r><w:r w:rsidRPr="0076634D"><w:rPr><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="0076634D"><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:i/><w:sz w:val="14"/><w:szCs w:val="14"/></w:rPr><w:t>Указывается участником закупки.</w:t></w:r></w:p></w:footnote></w:footnotes>